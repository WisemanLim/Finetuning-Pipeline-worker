# =============================================================================
# WFP ML Worker — GPU 학습 변형 (CUDA 12.1)
#
# Base: python:3.12-slim. CUDA 런타임 라이브러리는 PyTorch +cu121 휠에 번들됨.
# 호스트 요구사항:
#   - NVIDIA 드라이버 (libcuda.so, /dev/nvidia*)
#   - NVIDIA Container Toolkit (--gpus all)
#
# 사용:
#   docker build -f Dockerfile.gpu -t wfp-worker:gpu .
#   docker run --gpus all -p 8000:8000 wfp-worker:gpu
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — Builder: uv로 의존성 + PyTorch CUDA 휠 설치
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# 빌드 도구 (psutil/numpy 컴파일에 필요)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# uv 설치
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /build

COPY pyproject.toml ./

# 의존성만 먼저 — 레이어 캐시 효율
RUN uv venv /opt/venv --python 3.12 && \
    VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
        --index-strategy unsafe-best-match \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        "."

# 소스 + train_gpu extras (torch+cu121, transformers, peft, trl, bitsandbytes)
COPY src/ ./src/
RUN VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
        --index-strategy unsafe-best-match \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        ".[train_gpu]"

# -----------------------------------------------------------------------------
# Stage 2 — Runtime: 슬림 이미지 + 가상환경만 복사
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv \
    WFP_WORKER_HOST=0.0.0.0 \
    WFP_WORKER_PORT=8000

# 런타임 의존성 — libgomp1(OpenMP), curl(헬스체크), tini(PID1)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r wfp && useradd -r -g wfp -d /home/wfp -m wfp

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
RUN mkdir -p /home/wfp/.wfp/{models,jobs,checkpoints,artifacts} /data && \
    chown -R wfp:wfp /home/wfp/.wfp /app /data

COPY --chown=wfp:wfp src/ /app/src/

USER wfp
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "wfp_worker.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
