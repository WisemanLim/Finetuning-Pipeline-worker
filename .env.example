# =============================================================================
# Finetuning-Pipeline-worker 로컬 개발 환경 변수
# 복사: cp .env.example .env  (절대 커밋 금지)
# =============================================================================

# ---- 슈퍼바이저 (관리자 계정) ----
# 서버 시작 시 해당 계정이 없으면 자동 생성, 있으면 ADMIN 권한 보장.
# 회원가입으로 가입한 사용자는 항상 USER 권한.
SUPERVISOR_ID=admin@example.com
SUPERVISOR_PASSWORD=replace-with-strong-password

# ---- JWT ----
# 운영에서는 반드시 강한 랜덤값으로 교체 (openssl rand -base64 32)
JWT_SECRET=dev-jwt-secret-CHANGE-ME
JWT_ACCESS_EXPIRE_MIN=10080

# ---- DB ----
# 미지정 시 ~/.wfp/wfp.db (SQLite)
# DATABASE_URL=sqlite:////path/to/wfp.db
# make docker-infra 실행 후 PostgreSQL 사용 시 (외부 포트 5532):
# DATABASE_URL=postgresql://wfp:wfp-dev@localhost:5532/wfp

# ---- Redis (make docker-infra 실행 후, 외부 포트 6479) ----
# REDIS_URL=redis://localhost:6479/0

# ---- MinIO (make docker-infra 실행 후, 외부 포트 9100) ----
# S3_ENDPOINT=http://localhost:9100
# S3_ACCESS_KEY=wfp-minio
# S3_SECRET_KEY=wfp-minio-secret
# S3_BUCKET=wfp-artifacts

# ---- HuggingFace ----
# 비공개 모델 다운로드 시 필요
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxx
